# ─────────────────────────────────────────────────────────────────────────────
# Cloud Cost Analyzer — frontend server
# Copy to .env and set LIVE_API_URL. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Backend this UI talks to. No trailing slash.
LIVE_API_URL=http://your-backend-host:5000

# Port this server listens on.
FRONTEND_PORT=3000

# Bind address. Keep 127.0.0.1 when a reverse proxy on the same host fronts
# this; use 0.0.0.0 only in a container where the proxy is a separate host.
FRONTEND_HOST=127.0.0.1

# ── Deployment ───────────────────────────────────────────────────────────────
# Leave true only on your own machine. Werkzeug's debugger runs arbitrary code
# from the browser on any traceback, so this must be false anywhere reachable.
FRONTEND_DEBUG=true

# Set true when browsers reach THIS server over https, so the relayed session
# cookie carries Secure. Leave false for plain-http local dev, or the browser
# drops the cookie and login silently never sticks.
FRONTEND_COOKIE_SECURE=false

# Set true when behind nginx/ALB so X-Forwarded-Proto and -For are trusted.
# Only with a proxy actually in front — clients can otherwise forge them.
FRONTEND_BEHIND_PROXY=false

# ── TLS (only relevant when LIVE_API_URL is https) ───────────────────────────
# If the backend serves its leaf cert without the intermediate, put a bundle
# (certifi + that intermediate) here instead of turning verification off.
# LIVE_CA_BUNDLE=certs/live-ca-bundle.pem
#
# Last resort. Disables certificate verification entirely — never point this
# at a production host you care about.
# LIVE_VERIFY_TLS=false
